# ==========================================
# Entorno de ejecución
# ==========================================
APP_ENV=production

# ==========================================
# Configuración de PostgreSQL para Docker
# ==========================================
DB_PROD_NAME=proyecto_is1_2026_prod
DB_PROD_USER=qanda
DB_PROD_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA

# ==========================================
# Clave secreta de Flask
# ==========================================
SECRET_KEY=REEMPLAZAR_CON_UNA_CLAVE_SEGURA

# ==========================================
# Administrador inicial
# Utilizado por la migración de Alembic
# que crea el administrador inicial.
# ==========================================
ADMIN_NAME=NombreDelAdministrador
ADMIN_EMAIL=administrador@ejemplo.com
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA_DE_AL_MENOS_8_CARACTERES
