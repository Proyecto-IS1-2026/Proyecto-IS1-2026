# Entorno de ejecución
APP_ENV=development

# Seguridad
# Cambiar por un valor aleatorio. Obligatoria en producción.
SECRET_KEY=

# Configuración de PostgreSQL
DB_USER=is1_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Base de datos de desarrollo
DB_NAME=proyecto_is1_2026

# Base de datos de testing
DB_TEST_NAME=proyecto_is1_2026_test

# Base de datos de producción (obligatorias cuando APP_ENV=production)
DB_PROD_NAME=
DB_PROD_USER=
DB_PROD_PASSWORD=

# Pruebas automatizadas: base de mantenimiento con permiso CREATEDB.
# El fixture crea y elimina una base descartable con nombre único.
# TEST_DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/postgres

# Administrador inicial (requerido al ejecutar la nueva migración)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Servicio de Respuestas Automáticas (opcional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
